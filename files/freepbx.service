[Unit]
Description=FreePBX VoIP Server
After=asterisk.service mariadb.service network-online.target
# wants, not requires, for mariadb: a restart of the database used to stop this unit and
# asterisk with it, and fwconsole then brought asterisk back outside asterisk.service
Wants=network-online.target mariadb.service
Requires=asterisk.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/fwconsole start -q
ExecStop=/usr/sbin/fwconsole stop -q

[Install]
WantedBy=multi-user.target
